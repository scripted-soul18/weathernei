# Weather API Provider & Secrets (Optional, defaults to Open-Meteo & Open-Elevation)
WEATHER_API_PROVIDER=open-meteo
WEATHER_API_KEY=your_optional_custom_weather_api_key

# Database Connection (Defaults to fast local asynchronous SQLite)
DATABASE_URL=sqlite+aiosqlite:///./landslide_platform.db

# Server Settings
HOST=0.0.0.0
PORT=8000
